# ---------------------------------------------------------------------------
# Store — Backend environment configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# All secrets MUST be replaced with strong, unique values before deployment.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=3001

# Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use a least-privilege runtime user (not the superuser or migration user)
DATABASE_URL=postgresql://store_app:CHANGE_ME@localhost:5432/store_dev

# Database connection pool
DB_POOL_MAX=10
# Set DB_SSL=true for any non-local deployment
DB_SSL=false

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Session secret — minimum 32 characters of random data
# Generate with: openssl rand -base64 48
# Used to sign session cookies. Must be unique and never shared.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARS

# Session cookie name (default: store.sid)
SESSION_COOKIE_NAME=store.sid

# Session max age in seconds (default: 86400 = 24 hours)
SESSION_MAX_AGE=86400

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Paystack — TEST MODE ONLY
# ---------------------------------------------------------------------------
# Use sk_test_... key for sandbox testing. NEVER use sk_live_... in development.
# Keep this secret server-side. Never expose to frontend, logs, or Git.
# Register at https://dashboard.paystack.com to get test credentials.
# Without this key, payment initialization returns a 503 (not configured).
#
# Merchant settlement: This implementation uses a single Paystack account.
# Subaccounts for individual merchant settlement are NOT configured.
# All settlements go to the account associated with PAYSTACK_SECRET_KEY.
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME

# Callback URL after Paystack payment (browser redirect — does NOT confirm payment)
# Paystack redirects here; the frontend then polls /api/checkout/status/:token
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback

# ---------------------------------------------------------------------------
# AI Assistant (Day 6+)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-CHANGE_ME
# AI_MODEL=gpt-4o-mini
