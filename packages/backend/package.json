{
  "name": "@store/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:rollback": "tsx src/db/migrate.ts down",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@store/shared": "workspace:*",
    "argon2": "0.31.1",
    "compression": "1.8.0",
    "connect-pg-simple": "9.0.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csrf-csrf": "4.0.3",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "express-session": "1.18.1",
    "helmet": "8.0.0",
    "pg": "8.13.3"
  },
  "devDependencies": {
    "@types/compression": "1.7.5",
    "@types/connect-pg-simple": "7.0.3",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/express-session": "1.18.1",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.57",
    "@types/pg": "8.11.14",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.1.0",
    "ts-jest": "29.3.4",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
